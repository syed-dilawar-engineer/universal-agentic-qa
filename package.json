{
  "name": "universal-agentic-qa",
  "version": "0.1.0",
  "private": true,
  "description": "Production-oriented, open-source, AI-agent-driven QA automation platform",
  "author": "Antigravity Team",
  "license": "MIT",
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "pnpm -r run lint || true",
    "typecheck": "pnpm -r run typecheck",
    "qa": "pnpm --filter @agentic-qa/cli run dev"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
